# Safe example only. Copy to .dev.vars locally and replace placeholders.

EMDASH_ENCRYPTION_KEY=replace-with-local-development-key
BUILDER_MCP_TOKEN=ec_pat_replace-with-builder-mcp-token
BUILDER_MCP_PROVISION_SECRET=replace-with-builder-mcp-provision-secret
ASTROLOGYAPI_USER_ID=replace-with-astrologyapi-user-id
ASTROLOGYAPI_PASSWORD=replace-with-astrologyapi-password
ASTROPAGES_PLATFORM_GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
SITE_ORIGIN=http://localhost:4321
SES_SENDER_EMAIL=verified-sender@example.com
SES_SENDER_NAME=Nine Centres
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
POSTHOG_PROJECT_API_KEY=phc_replace-with-posthog-project-key
POSTHOG_HOST=https://us.i.posthog.com

# Generated-site SSO/runtime plumbing used by content studio integrations.
ASTROPAGES_PROJECT_ID=replace-with-project-id
ASTROPAGES_SITE_ENVIRONMENT=preview
ASTROPAGES_SSO_PUBLIC_JWK=replace-with-control-plane-public-jwk
ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN=replace-with-control-plane-callback-token
ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL=https://astropages.example

# Cloudflare deployment/resource helpers.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_DEV_WORKERS_SUBDOMAIN=replace-with-workers-dev-subdomain
CLOUDFLARE_SECRETS_STORE_ID=replace-with-optional-cloudflare-secret-store-id
GH_REPOSITORY_VARIABLES_TOKEN=replace-with-github-token
PREVIEW_SITE_D1_DATABASE_ID=replace-with-preview-d1-id
PREVIEW_SITE_SESSION_KV_NAMESPACE_ID=replace-with-preview-kv-id
PREVIEW_SITE_URL=https://astropages-base-template-preview.example.workers.dev
PRODUCTION_SITE_D1_DATABASE_ID=replace-with-production-d1-id
PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID=replace-with-production-kv-id
PRODUCTION_SITE_URL=https://astropages-base-template-production.example.workers.dev
