---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import BlogArticlesGrid from "../components/blog/BlogArticlesGrid.astro";
import { BLOG_ARTICLES } from "../data/blog-articles.ts";
import { getLocaleFromUrl, localizePath } from "../data/localization-contract.ts";

export const prerender = false;
const locale = getLocaleFromUrl(Astro.request.url);
const homeHref = localizePath("/", locale);

const seoContent = {
  seo_title: "Human Design Writing & Field Notes — Nine Centres",
  seo_description: "Deep-dive guides on the 9 centres, strategy, authorities, energy types, and practical deconditioning.",
  seo_canonical_path: "/blog",
  seo_robots: "index,follow",
  og_title: "Human Design Writing & Field Notes — Nine Centres",
  og_description: "Explore essays on human design mechanics, defined and open centres, and real-world experiments.",
  og_image: "/_assets/aliases/logo/logo.svg",
  og_image_alt: "Nine Centres Human Design Diagram",
  twitter_card: "summary_large_image",
  twitter_title: "Human Design Writing — Nine Centres",
  twitter_description: "Practical guides and deconditioning field notes for Human Design.",
  twitter_image: "/_assets/aliases/logo/logo.svg",
};
---

<BaseLayout
  seo={seoContent}
  title="Human Design Writing & Field Notes — Nine Centres"
>
  <div class="site-wrap">
    <Header brandName="Nine Centres" homeHref={homeHref} plateHref={`${homeHref}#plate`} typesHref={`${homeHref}#types`} readingsHref={`${homeHref}#readings`} questionsHref={`${homeHref}#faq`} chartHref={`${homeHref}#chart`} />

    <main class="blog-main-content">
      <!-- Blog Hero Section -->
      <section class="blog-hero">
        <div class="blog-hero-top">
          <a href={homeHref} class="back-home-link">&larr; Back to home</a>
          <p class="blog-eyebrow">FIELD NOTES &middot; PLAIN LANGUAGE</p>
        </div>
        <h1 class="blog-hero-title">
          Reading the chart <span class="accent-text">yourself.</span>
        </h1>
        <p class="blog-hero-lead">
          Essays on human design mechanics, the wisdom of open centres, practical deconditioning protocols, and real-world strategy experiments.
        </p>
      </section>

      <!-- Articles Grid Section composed of common component -->
      <section class="blog-grid-section">
        <BlogArticlesGrid articles={BLOG_ARTICLES} />
      </section>
    </main>

    <Footer brandName="Nine Centres" plateHref={`${homeHref}#plate`} readingsHref={`${homeHref}#readings`} questionsHref={`${homeHref}#faq`} chartHref={`${homeHref}#chart`} />
  </div>
</BaseLayout>

<style>
  .site-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #E7E9EF;
    color: #16203C;
  }

  .blog-main-content {
    flex: 1;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 48px 32px 96px;
  }

  .blog-hero {
    border-bottom: 1.5px solid #16203C;
    padding-bottom: 40px;
    margin-bottom: 56px;
  }

  .blog-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .back-home-link {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2B45C8;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .back-home-link:hover {
    transform: translateX(-4px);
  }

  .blog-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #B62F49;
    margin: 0;
  }

  .blog-hero-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5.5vw, 68px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin: 0 0 20px;
    max-width: 900px;
  }

  .accent-text {
    color: #B62F49;
  }

  .blog-hero-lead {
    font-size: 18px;
    line-height: 1.5;
    color: #3C4661;
    max-width: 720px;
    margin: 0;
  }

  @media (max-width: 640px) {
    .blog-main-content {
      padding: 32px 20px 64px;
    }
  }
</style>
