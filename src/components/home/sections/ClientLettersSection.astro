---
import { TESTIMONIALS } from "../../../data/human-design.constants.ts";

const { eyebrow = "Letters from clients", eyebrowEdit = {} } = Astro.props;
---

<section class="client-letters-section" data-client-letters-section>
  <p class="letters-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
  <div class="letters-grid">
    {TESTIMONIALS.map((t, i) => (
      <figure class={`testimonial-card test-card-${i + 1}`}>
        <blockquote class="testimonial-quote">
          {t.quote}
        </blockquote>
        <figcaption class="testimonial-author">
          {t.author}
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .client-letters-section {
    margin-top: 104px;
    background: #2B45C8;
    color: #E7E9EF;
    padding: 64px 32px;
  }

  .letters-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #B62F49;
    margin: 0 0 44px;
  }

  .letters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    align-items: start;
  }

  .testimonial-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .test-card-1 { padding-top: 0; }
  .test-card-2 { padding-top: 40px; }
  .test-card-3 { padding-top: 80px; }

  .testimonial-quote {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(17px, 1.7vw, 23px);
    line-height: 1.3;
    letter-spacing: -0.04em;
    margin: 0;
    text-wrap: pretty;
  }

  .testimonial-author {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #D8DEEC;
  }

  @media (max-width: 900px) {
    .letters-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .test-card-2, .test-card-3 {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .client-letters-section {
      padding: 48px 20px;
    }
  }
</style>

<style>
  .client-letters-section { width: min(1200px, calc(100% - 52px)); margin: 0 auto 74px; background: var(--color-ink); color: var(--color-soft-blue); padding: 52px 44px; }
  .letters-eyebrow { color: #F0C9D2; font-family: var(--font-mono); font-size: 10px; font-weight: 400; letter-spacing: 0.2em; margin: 0 0 32px; }
  .letters-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .testimonial-card { background: transparent; border: 0; border-left: 1px solid rgba(216, 222, 236, 0.3); border-radius: 0; padding: 0 0 0 20px; transform: none; box-shadow: none; }
  .testimonial-quote { color: var(--color-text-light); font-family: var(--font-display); font-size: 19.5px; font-weight: 400; line-height: 1.42; }
  .testimonial-author { color: #93A0B8; font-family: var(--font-mono); font-size: 9.5px; font-weight: 400; letter-spacing: 0.16em; }

  @media (max-width: 760px) { .client-letters-section { width: min(100% - 32px, 1200px); padding: 36px 24px; } .letters-grid { grid-template-columns: 1fr; } }
</style>
