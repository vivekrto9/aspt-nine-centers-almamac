---
import { VOCABULARY_CONCEPTS } from "../../../data/human-design.constants.ts";

const { eyebrow = "Vocabulary", title = "Four words to learn first", eyebrowEdit = {}, titleEdit = {} } = Astro.props;
---

<section class="four-concepts-section" data-four-concepts-section>
  <div class="section-header-grid">
    <span class="section-number">02</span>
    <div class="section-title-wrap">
      <p class="section-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
      <h2 class="section-heading" {...titleEdit}>{title}</h2>
    </div>
  </div>

  <div class="concepts-grid">
    {VOCABULARY_CONCEPTS.map((c, i) => (
      <div class={`concept-card concept-step-${i + 1}`}>
        <p class="concept-num">{c.num}</p>
        <h3 class="concept-title">{c.title}</h3>
        <p class="concept-body">{c.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .four-concepts-section {
    padding: 104px 32px 0;
  }

  .section-header-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: end;
    margin-bottom: 52px;
  }

  .section-number {
    grid-column: 1 / span 2;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 96px;
    line-height: 0.72;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px #2B45C8;
  }

  .section-title-wrap {
    grid-column: 4 / span 7;
  }

  .section-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #B62F49;
    margin: 0 0 12px;
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    align-items: start;
  }

  .concept-card {
    border-top: 3px solid #2B45C8;
    padding-top: 20px;
  }

  .concept-step-1 { margin-top: 0; }
  .concept-step-2 { margin-top: 44px; }
  .concept-step-3 { margin-top: 88px; }
  .concept-step-4 { margin-top: 132px; }

  .concept-num {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7C87A0;
    margin: 0 0 14px;
  }

  .concept-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.04;
    letter-spacing: -0.045em;
    margin: 0 0 12px;
  }

  .concept-body {
    font-size: 15.5px;
    line-height: 1.6;
    color: #3C4661;
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .section-header-grid {
      grid-template-columns: 1fr;
    }
    .section-number, .section-title-wrap {
      grid-column: span 1;
    }
    .concepts-grid {
      grid-template-columns: 1fr 1fr;
    }
    .concept-step-2, .concept-step-3, .concept-step-4 {
      margin-top: 0;
    }
  }

  @media (max-width: 600px) {
    .concepts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style>
  .four-concepts-section { width: min(1200px, calc(100% - 52px)); margin: 0 auto; padding: 34px 0 70px; border-top: 1px solid var(--color-ink); }
  .section-header-grid { display: flex; align-items: baseline; gap: 20px; margin: 0 0 30px; }
  .section-number { font-family: var(--font-mono); font-size: 0; color: var(--color-accent); }
  .section-number::after { content: "§ I"; font-size: 10.5px; letter-spacing: 0.2em; }
  .section-title-wrap { display: contents; }
  .section-eyebrow { display: none; }
  .section-heading { font-family: var(--font-display); font-size: 36px; font-weight: 500; line-height: 1.1; letter-spacing: 0; margin: 0; }
  .concepts-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-left: 1px solid var(--color-subtle-border); }
  .concept-card { background: transparent; color: var(--color-ink); border: 0; border-right: 1px solid var(--color-subtle-border); padding: 0 24px 8px; transform: none; box-shadow: none; }
  .concept-num { color: var(--color-cobalt); font-family: var(--font-mono); font-size: 10px; font-weight: 400; letter-spacing: 0.18em; margin-bottom: 10px; }
  .concept-title { font-family: var(--font-display); font-size: 23px; font-weight: 500; line-height: 1.14; letter-spacing: 0; }
  .concept-body { color: var(--color-text-dark); font-size: 15.5px; line-height: 1.62; }

  @media (max-width: 900px) { .concepts-grid { grid-template-columns: repeat(2, 1fr); row-gap: 30px; } }
  @media (max-width: 760px) { .four-concepts-section { width: min(100% - 32px, 1200px); } .concepts-grid { grid-template-columns: 1fr; } }
</style>
