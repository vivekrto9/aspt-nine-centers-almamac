---
import { BLOG_ARTICLES } from "../../../data/blog-articles.ts";
import { getLocaleFromUrl, localizePath } from "../../../data/localization-contract.ts";

interface Props {
  limit?: number;
  eyebrow?: string;
  title?: string;
  viewAll?: string;
  eyebrowEdit?: Record<string, string>;
  titleEdit?: Record<string, string>;
  viewAllEdit?: Record<string, string>;
}

const { limit = 3, eyebrow = "Writing", title = "Reading the chart yourself", viewAll = "View all articles →", eyebrowEdit = {}, titleEdit = {}, viewAllEdit = {} } = Astro.props;
const displayArticles = BLOG_ARTICLES.slice(0, limit);
const locale = getLocaleFromUrl(Astro.request.url);
---

<section class="articles-section" data-articles-section>
  <div class="section-header-grid">
    <span class="section-number">07</span>
    <div class="section-title-wrap">
      <p class="section-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
      <h2 class="section-heading" {...titleEdit}>{title}</h2>
    </div>
    <div class="section-cta-wrap">
      <a href={localizePath("/blog", locale)} class="view-all-cta" data-view-all-cta {...viewAllEdit}>{viewAll}</a>
    </div>
  </div>

  <div class="articles-grid">
    {displayArticles.map((a) => (
      <a href={localizePath(`/blog/${a.slug}`, locale)} class="article-card" data-article-slug={a.slug}>
        <div class="article-thumb">
          <span class="thumb-tag">{a.tag}</span>
        </div>
        <h3 class="article-title">{a.title}</h3>
      </a>
    ))}
  </div>
</section>

<style>
  .articles-section {
    padding: 104px 32px 0;
  }

  .section-header-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 24px;
    align-items: end;
    margin-bottom: 48px;
  }

  .section-number {
    grid-column: 1 / span 2;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 96px;
    line-height: 0.72;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px #2B45C8;
  }

  .section-title-wrap {
    grid-column: 3 / span 7;
  }

  .section-cta-wrap {
    grid-column: 10 / span 3;
    display: flex;
    justify-content: flex-end;
  }

  .view-all-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2B45C8;
    background: transparent;
    padding: 10px 18px;
    border: 1.5px solid #2B45C8;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }

  .view-all-cta:hover {
    background: #2B45C8;
    color: #E7E9EF;
    box-shadow: 4px 4px 0 #B62F49;
  }

  .section-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #B62F49;
    margin: 0 0 12px;
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    color: #16203C;
    border: 1.5px solid #16203C;
    background: #E7E9EF;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .article-card:hover {
    box-shadow: 10px 10px 0 #B62F49;
    transform: translate(-2px, -2px);
  }

  .article-thumb {
    aspect-ratio: 4 / 3;
    background: #2B45C8;
    border-bottom: 1.5px solid #16203C;
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }

  .thumb-tag {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #D8DEEC;
  }

  .article-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.14;
    letter-spacing: -0.04em;
    margin: 0;
    padding: 20px 22px 24px;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .section-header-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .section-number, .section-title-wrap, .section-cta-wrap {
      grid-column: span 1;
    }
    .section-cta-wrap {
      justify-content: flex-start;
    }
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style>
  .articles-section { width: min(1200px, calc(100% - 52px)); margin: 0 auto; padding: 34px 0 74px; border-top: 1px solid var(--color-ink); }
  .section-header-grid { display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 20px; margin: 0 0 30px; }
  .section-number { font-family: var(--font-mono); font-size: 0; color: var(--color-accent); }
  .section-number::after { content: "§ VI"; font-size: 10.5px; letter-spacing: 0.2em; }
  .section-title-wrap { display: contents; }
  .section-eyebrow { display: none; }
  .section-heading { font-family: var(--font-display); font-size: 36px; font-weight: 500; line-height: 1.08; letter-spacing: 0; margin: 0; }
  .view-all-cta { color: #5A6480; font-family: var(--font-mono); font-size: 10px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; }
  .articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-left: 1px solid var(--color-subtle-border); }
  .article-card { position: relative; color: var(--color-ink); border: 0; border-right: 1px solid var(--color-subtle-border); padding: 0 24px 8px; transform: none; box-shadow: none; transition: background-color 0.22s ease, transform 0.22s ease; }
  .article-thumb { aspect-ratio: 4 / 3; background: #E7EAF1; border: 1px solid var(--color-ink); transition: background-color 0.22s ease, box-shadow 0.22s ease; }
  .thumb-tag { color: #5A6480; font-family: var(--font-mono); font-size: 9.5px; font-weight: 400; letter-spacing: 0.14em; }
  .article-title { font-family: var(--font-display); font-size: 21px; font-weight: 500; line-height: 1.16; letter-spacing: 0; }
  .article-title::after { content: "↗"; display: inline-block; margin-left: 0.45em; color: var(--color-cobalt); font-family: var(--font-mono); font-size: 0.68em; opacity: 0; transform: translate(-5px, 4px); transition: opacity 0.18s ease, transform 0.18s ease; }
  .article-card:hover,
  .article-card:focus-visible { color: var(--color-ink); background: #EEF1F8; box-shadow: none; transform: translateY(-4px); }
  .article-card:hover .article-thumb,
  .article-card:focus-visible .article-thumb { background: #F6F7FA; box-shadow: inset 0 0 0 3px var(--color-cobalt); }
  .article-card:hover .article-title::after,
  .article-card:focus-visible .article-title::after { opacity: 1; transform: translate(0, 0); }
  .article-card:focus-visible { outline: 2px solid var(--color-cobalt); outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .article-card, .article-thumb, .article-title::after { transition: none; }
    .article-card:hover, .article-card:focus-visible { transform: none; }
  }

  @media (max-width: 760px) { .articles-section { width: min(100% - 32px, 1200px); } .section-header-grid { grid-template-columns: auto 1fr; } .section-cta-wrap { grid-column: 2; } .articles-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
