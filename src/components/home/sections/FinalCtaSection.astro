---
interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  titleEdit?: Record<string, string>;
  subtitleEdit?: Record<string, string>;
  buttonEdit?: Record<string, string>;
}

const {
  title = "Start with the chart. Decide about the reading after.",
  subtitle = "Free, sent within a day.",
  buttonText = "Get your free bodygraph",
  buttonHref = "#chart",
  titleEdit = {},
  subtitleEdit = {},
  buttonEdit = {},
} = Astro.props;
---

<section class="final-cta-section" data-final-cta-section>
  <div class="cta-banner">
    <div class="cta-text-wrap">
      <h2 class="cta-title" {...titleEdit}>{title}</h2>
      <p class="cta-subtitle" {...subtitleEdit}>{subtitle}</p>
    </div>
    <a href={buttonHref} class="cta-action-btn" {...buttonEdit}>
      {buttonText}
    </a>
  </div>
</section>

<style>
  .final-cta-section {
    padding: 104px 32px 96px;
  }

  .cta-banner {
    background: #16203C;
    color: #E7E9EF;
    padding: 64px 44px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin: 0 0 14px;
    max-width: 20ch;
  }

  .cta-subtitle {
    font-size: 16px;
    line-height: 1.5;
    color: #D8DEEC;
    margin: 0;
  }

  .cta-action-btn {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #16203C;
    background: #B62F49;
    border: 1.5px solid #B62F49;
    padding: 18px 30px;
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .cta-action-btn:hover {
    background: #E7E9EF;
    border-color: #E7E9EF;
    color: #16203C;
  }

  @media (max-width: 768px) {
    .final-cta-section {
      padding: 64px 20px 48px;
    }
    .cta-banner {
      padding: 40px 24px;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<style>
  .final-cta-section { width: min(1200px, calc(100% - 52px)); margin: 0 auto; padding: 0 0 74px; }
  .cta-banner { background: var(--color-ink); color: var(--color-soft-blue); border: 0; box-shadow: none; padding: 52px 44px; }
  .cta-title { color: var(--color-text-light); font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 42px); font-weight: 500; line-height: 1.06; letter-spacing: 0; }
  .cta-subtitle { color: #95A0BC; font-family: var(--font-mono); font-size: 10.5px; font-weight: 400; letter-spacing: 0.16em; text-transform: uppercase; }
  .cta-action-btn { background: var(--color-paper); color: var(--color-ink); border: 0; font-size: 15px; font-weight: 500; letter-spacing: 0; text-transform: none; }
  .cta-action-btn:hover { background: var(--color-cobalt); color: #fff; }
  @media (max-width: 760px) { .final-cta-section { width: min(100% - 32px, 1200px); } .cta-banner { padding: 36px 24px; } }
</style>
