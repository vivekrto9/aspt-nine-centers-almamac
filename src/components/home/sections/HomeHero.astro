---
interface Props {
  dateline?: string;
  title?: string;
  body?: string;
  kickerEdit?: Record<string, string>;
  titleEdit?: Record<string, string>;
  bodyEdit?: Record<string, string>;
  subtext?: string;
  subtextEdit?: Record<string, string>;
  sideNote?: string;
  sideNoteEdit?: Record<string, string>;
}

const {
  dateline = "Filed under: how you decide",
  title = "Your chart already knows how you were built to decide.",
  body = "A map of how you are built to decide, drawn from your birth date, time and place. Nothing here forecasts events.",
  kickerEdit = {}, titleEdit = {}, bodyEdit = {},
  subtext = "Coloured centres are consistent in you. Open ones are where you absorb everyone else. Start with the free chart, decide about a reading after.",
  subtextEdit = {},
  sideNote = "Every chart on this page is drawn and read by one person, in plain language, and the recording stays yours.",
  sideNoteEdit = {},
} = Astro.props;
---

<section class="home-hero" data-home-hero>
  <div class="hero-copy">
    <p class="hero-dateline" data-hero-dateline {...kickerEdit}>{dateline}</p>
    <h1 class="hero-title" data-hero-title {...titleEdit}>{title}</h1>
    <div class="hero-columns">
      <p class="lead-text" {...bodyEdit}>{body}</p>
      <p class="sub-text" {...subtextEdit}>{subtext}</p>
      <p class="side-note" {...sideNoteEdit}>{sideNote}</p>
    </div>
    <dl class="hero-stats">
      <div><dt>1,400+</dt><dd>Charts read</dd></div>
      <div><dt>75 min</dt><dd>Standard session</dd></div>
      <div><dt>Recorded</dt><dd>Yours to keep</dd></div>
    </dl>
  </div>
</section>

<style>
  .home-hero { width: min(1200px, calc(100% - 52px)); margin: 0 auto; padding: 38px 0 10px; }
  .hero-copy { padding: 0 44px 34px 0; }
  .hero-dateline, .hero-stats dd { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.18em; }
  .hero-dateline { color: var(--color-accent); font-size: 11px; margin: 0 0 18px; }
  .hero-title { max-width: 820px; font-family: var(--font-display); font-size: clamp(42px, 5vw, 56px); font-weight: 500; line-height: 1.02; letter-spacing: -0.015em; margin: 0 0 26px; text-wrap: balance; }
  .hero-columns { max-width: 760px; columns: 2; column-gap: 34px; column-rule: 1px solid var(--color-subtle-border); }
  .hero-columns p { break-inside: avoid; color: var(--color-text-dark); font-size: 16.5px; line-height: 1.66; margin: 0 0 14px; text-wrap: pretty; }
  .hero-columns .lead-text { color: var(--color-ink); }
  .hero-columns .lead-text::first-letter { float: left; color: var(--color-cobalt); font-family: var(--font-display); font-size: 58px; line-height: 0.78; padding: 6px 10px 0 0; }
  .hero-stats { display: flex; flex-wrap: wrap; gap: 26px; border-top: 1px solid var(--color-subtle-border); margin: 30px 0 0; padding-top: 20px; }
  .hero-stats div { min-width: 150px; }
  .hero-stats dt { font-family: var(--font-display); font-size: 27px; font-weight: 500; margin-bottom: 3px; }
  .hero-stats dd { color: #5A6480; font-size: 10px; margin: 0; }

  @media (max-width: 760px) {
    .home-hero { width: min(100% - 32px, 1200px); padding-top: 28px; }
    .hero-copy { padding-right: 0; }
    .hero-columns { columns: 1; }
    .hero-title { font-size: clamp(38px, 12vw, 50px); }
  }
</style>
