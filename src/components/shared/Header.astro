---
interface Props {
  brandName?: string;
  brandEdit?: Record<string, string>;
  homeHref?: string;
  plateHref?: string;
  typesHref?: string;
  readingsHref?: string;
  questionsHref?: string;
  chartHref?: string;
}

const {
  brandName = "Nine Centres",
  brandEdit = {},
  homeHref = "#top",
  plateHref = "#plate",
  typesHref = "#types",
  readingsHref = "#readings",
  questionsHref = "#faq",
  chartHref = "#chart",
} = Astro.props;
---

<div class="almanac-ribbon">
  <div>
    <p>Charts read by hand · one at a time</p>
    <a href={chartHref}>Free bodygraph inside →</a>
  </div>
</div>

<header class="hd-header" data-hd-header>
  <div class="masthead">
    <a href={homeHref} class="brand-link" data-brand-link {...brandEdit}>{brandName}</a>
    <p>An almanac of the bodygraph</p>
  </div>
  <div class="edition-bar">
    <span>Established 2019 · read by hand</span>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href={plateHref}>Plate</a>
      <a href={typesHref}>Types</a>
      <a href={readingsHref}>Readings</a>
      <a href={questionsHref}>Questions</a>
    </nav>
    <span class="edition-number">No. 07</span>
  </div>
</header>

<style>
  .almanac-ribbon { background: var(--color-ink); color: var(--color-soft-blue); }
  .almanac-ribbon > div, .hd-header { width: min(1200px, calc(100% - 52px)); margin: 0 auto; }
  .almanac-ribbon > div { min-height: 36px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; }
  .almanac-ribbon p, .almanac-ribbon a, .edition-bar, .masthead p { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase; }
  .almanac-ribbon p { margin: 0; }
  .almanac-ribbon a { color: #F0C9D2; }
  .hd-header { padding-top: 34px; }
  .masthead { border-top: 3px solid var(--color-ink); border-bottom: 1px solid var(--color-ink); padding: 22px 0 14px; text-align: center; }
  .brand-link { display: block; color: var(--color-ink); font-family: var(--font-display); font-size: clamp(48px, 7vw, 70px); font-weight: 600; line-height: 0.92; letter-spacing: -0.02em; }
  .masthead p { color: #5A6480; margin: 14px 0 0; letter-spacing: 0.42em; }
  .edition-bar { min-height: 39px; border-bottom: 1px solid var(--color-ink); color: #5A6480; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; letter-spacing: 0.16em; }
  .nav-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 22px; }
  .nav-links a { color: var(--color-ink); }
  .nav-links a:hover, .brand-link:hover { color: var(--color-accent); }
  .edition-number { color: var(--color-accent); text-align: right; }

  @media (max-width: 760px) {
    .almanac-ribbon > div, .hd-header { width: min(100% - 32px, 1200px); }
    .hd-header { padding-top: 20px; }
    .masthead { padding-top: 18px; }
    .masthead p { letter-spacing: 0.23em; }
    .edition-bar { grid-template-columns: 1fr auto; padding: 9px 0; }
    .edition-bar > span:first-child { display: none; }
    .nav-links { justify-content: flex-start; gap: 14px; }
  }
</style>
