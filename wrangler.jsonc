{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aspt-nine-centers-almamac",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/_emdash/*", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aspt-nine-centers-almamac-site",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aspt-nine-centers-almamac-media",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "LOCAL_ASPT_NINE_CENTERS_ALMAMAC_SESSION_KV",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "env": {
    "preview": {
      "name": "aspt-nine-centers-almamac-preview",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "run_worker_first": ["/_emdash/*", "/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aspt-nine-centers-almamac-preview-site",
          "database_id": "PREVIEW_D1_DATABASE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "aspt-nine-centers-almamac-preview-media",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "PREVIEW_SESSION_KV_NAMESPACE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "vars": {
        "PUBLIC_GTM_CONTAINER_ID": "",
        "PUBLIC_META_PIXEL_ID": "",
        "PUBLIC_GOOGLE_ADS_TAG_ID": "",
        "PUBLIC_GOOGLE_ADS_CONVERSION_LABEL": "",
      },
      "secrets": {
        "required": [
          "EMDASH_ENCRYPTION_KEY",
          "BUILDER_MCP_TOKEN",
          "BUILDER_MCP_PROVISION_SECRET"
        ],
      },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
    },
    "production": {
      "name": "aspt-nine-centers-almamac-production",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "run_worker_first": ["/_emdash/*", "/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aspt-nine-centers-almamac-production-site",
          "database_id": "PRODUCTION_D1_DATABASE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "aspt-nine-centers-almamac-production-media",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "PRODUCTION_SESSION_KV_NAMESPACE_ID_FROM_WRANGLER_CREATE",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "vars": {
        "PUBLIC_GTM_CONTAINER_ID": "",
        "PUBLIC_META_PIXEL_ID": "",
        "PUBLIC_GOOGLE_ADS_TAG_ID": "",
        "PUBLIC_GOOGLE_ADS_CONVERSION_LABEL": "",
      },
      "secrets": {
        "required": [
          "EMDASH_ENCRYPTION_KEY",
          "BUILDER_MCP_TOKEN",
          "BUILDER_MCP_PROVISION_SECRET"
        ],
      },
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
    },
  },
}
